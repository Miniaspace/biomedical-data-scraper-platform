  "html_sample": "<!DOCTYPE html><html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>NIMH NRGR – Transition Notice</title>\n    <style>\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            background-color: #f8f9fa;\n            color: #222;\n            text-align: center;\n            padding: 60px 20px;\n        }\n\n        .logo {\n            width: 160px;\n            margin-bottom: 30px;\n        }\n\n        .container {\n            background: white;\n            max-width: 600px;\n            margin: auto;\n            padding: 40px;\n            border-radius: 10px;\n            box-shadow: 0 2px 6px rgba(0,0,0,0.1);\n        }\n\n        h1 {\n            font-size: 1.5em;\n            color: #00447c;\n            margin-bottom: 20px;\n        }\n\n        p {\n            font-size: 1.1em;\n            line-height: 1.6em;\n        }\n\n        .updated {\n            margin-top: 25px;\n            font-size: 0.9em;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <img src=\"https://www.nimh.nih.gov/sites/default/files/images/nimh-repository-and-genomics-resource-logo.PNG\" alt=\"NIMH Logo\" class=\"logo\">\n        <h1>National Institute of Mental Health (NIMH)<br>Repository and Genomic Resource (NRGR)</h1>\n        <p>\n            NRGR is in the process of transferring operations from Rutgers University to Coriell Institute for Medical Research, and as a result, most operations are currently paused.\n            NRGR services are anticipated to resume at Coriell in Spring 2026. Please continue to check this page for updates. If you have an urgent request, you may contact NIMH.genomics.resources@mail.nih.gov.\n        </p>\n        <p class=\"updated\">This page was last updated on <strong>November 24, 2025</strong>.</p>\n    </div>\n\n\n</body></html>"
