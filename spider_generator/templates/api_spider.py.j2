"""
{{ spider_description }}

生成时间: {{ generation_time }}
平台URL: {{ platform_url }}
采集策略: API采集
"""

import scrapy
from scrapy import Request
import uuid
import json
from datetime import datetime
from typing import Dict, Any, Optional, List
import logging

logger = logging.getLogger(__name__)


class {{ spider_class_name }}(scrapy.Spider):
    """{{ platform_name }} API数据采集器"""
    
    name = "{{ spider_name }}"
    
    # API配置
    api_base_url = "{{ api_base_url }}"
    api_endpoints = {{ api_endpoints }}
    
    custom_settings = {
        'DOWNLOAD_DELAY': {{ download_delay }},
        'CONCURRENT_REQUESTS': {{ concurrent_requests }},
        'ITEM_PIPELINES': {
            'pipelines.enhanced_files_pipeline.EnhancedFilesPipeline': 1,
        },
        'FILES_STORE': './downloads/{{ spider_name }}',
        'FEEDS': {
            f'output/{{ spider_name }}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.jsonl': {
                'format': 'jsonlines',
                'encoding': 'utf-8',
                'overwrite': False,
            },
            f'output/{{ spider_name }}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.csv': {
                'format': 'csv',
                'encoding': 'utf-8',
                'overwrite': False,
            },
        },
    }
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.stats = {
            'total_items': 0,
            'total_api_calls': 0,
            'errors': 0,
        }
        
        # API请求头
        self.api_headers = {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'User-Agent': 'Mozilla/5.0 (compatible; BiomedicalScraper/1.0)',
        }
    
    def start_requests(self):
        """生成初始API请求"""
        # 获取列表数据
        list_endpoint = self.api_endpoints.get('list', '')
        
        if list_endpoint:
            api_url = f"{self.api_base_url}{list_endpoint}"
            
            # 添加分页参数
            params = {
                'page': 1,
                'limit': {{ items_per_page }},
            }
            
            yield Request(
                url=api_url,
                method='GET',
                headers=self.api_headers,
                callback=self.parse_api_list,
                errback=self.handle_error,
                meta={
                    'page': 1,
                    'params': params
                },
                dont_filter=True
            )
    
    def parse_api_list(self, response):
        """
        解析API列表响应
        
        API响应格式:
        {{ api_response_format }}
        """
        self.stats['total_api_calls'] += 1
        
        try:
            data = json.loads(response.text)
        except json.JSONDecodeError as e:
            logger.error(f"JSON解析失败: {str(e)}")
            return
        
        # 提取数据项（根据API响应结构调整）
        items = self._extract_items_from_response(data)
        logger.info(f"API返回 {len(items)} 个项目")
        
        for item_data in items:
            # 如果需要详情数据，发起详情请求
            {% if needs_detail_api %}
            item_id = item_data.get('{{ id_field }}')
            if item_id:
                detail_endpoint = self.api_endpoints.get('detail', '').format(id=item_id)
                detail_url = f"{self.api_base_url}{detail_endpoint}"
                
                yield Request(
                    url=detail_url,
                    method='GET',
                    headers=self.api_headers,
                    callback=self.parse_api_detail,
                    errback=self.handle_error,
                    meta={'list_data': item_data}
                )
            {% else %}
            # 直接处理列表数据
            yield self.process_item(item_data)
            {% endif %}
        
        # 处理分页
        current_page = response.meta.get('page', 1)
        total_pages = self._extract_total_pages(data)
        
        if total_pages and current_page < total_pages:
            next_page = current_page + 1
            params = response.meta.get('params', {})
            params['page'] = next_page
            
            list_endpoint = self.api_endpoints.get('list', '')
            api_url = f"{self.api_base_url}{list_endpoint}"
            
            logger.info(f"请求下一页: {next_page}/{total_pages}")
            
            yield Request(
                url=api_url,
                method='GET',
                headers=self.api_headers,
                callback=self.parse_api_list,
                errback=self.handle_error,
                meta={
                    'page': next_page,
                    'params': params
                },
                dont_filter=True
            )
    
    {% if needs_detail_api %}
    def parse_api_detail(self, response):
        """解析API详情响应"""
        self.stats['total_api_calls'] += 1
        
        try:
            detail_data = json.loads(response.text)
        except json.JSONDecodeError as e:
            logger.error(f"JSON解析失败: {str(e)}")
            return
        
        # 合并列表数据和详情数据
        list_data = response.meta.get('list_data', {})
        combined_data = {**list_data, **detail_data}
        
        yield self.process_item(combined_data)
    {% endif %}
    
    def process_item(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """
        处理单个数据项
        
        Args:
            data: API返回的原始数据
            
        Returns:
            标准化的item
        """
        track_id = str(uuid.uuid4())
        
        item = {
            'track_id': track_id,
            'crawl_time': datetime.now().isoformat(),
            'platform': '{{ platform_name }}',
            'data_source': 'api',
        }
        
        # 字段映射
        field_mapping = {{ field_mapping }}
        
        for our_field, api_field in field_mapping.items():
            value = self._get_nested_value(data, api_field)
            if value:
                item[our_field] = value
        
        # 提取文件URL
        file_urls = self._extract_file_urls(data, track_id)
        if file_urls:
            item['file_urls'] = file_urls
        
        self.stats['total_items'] += 1
        logger.info(f"处理项目: {item.get('title', 'N/A')[:50]}")
        
        return item
    
    def _extract_items_from_response(self, data: Dict[str, Any]) -> List[Dict]:
        """
        从API响应中提取数据项列表
        
        根据API响应结构调整此方法
        """
        # 常见的响应结构
        if 'data' in data:
            if isinstance(data['data'], list):
                return data['data']
            elif 'items' in data['data']:
                return data['data']['items']
            elif 'results' in data['data']:
                return data['data']['results']
        elif 'results' in data:
            return data['results']
        elif 'items' in data:
            return data['items']
        elif isinstance(data, list):
            return data
        
        logger.warning(f"无法识别API响应结构: {list(data.keys())}")
        return []
    
    def _extract_total_pages(self, data: Dict[str, Any]) -> Optional[int]:
        """提取总页数"""
        # 常见的分页字段
        pagination_paths = [
            ['pagination', 'total_pages'],
            ['meta', 'total_pages'],
            ['total_pages'],
            ['page_count'],
        ]
        
        for path in pagination_paths:
            value = self._get_nested_value(data, '.'.join(path))
            if value and isinstance(value, int):
                return value
        
        return None
    
    def _get_nested_value(self, data: Dict, path: str) -> Any:
        """
        获取嵌套字典的值
        
        Args:
            data: 数据字典
            path: 路径，用点分隔，如 'user.profile.name'
            
        Returns:
            值或None
        """
        keys = path.split('.')
        value = data
        
        for key in keys:
            if isinstance(value, dict) and key in value:
                value = value[key]
            else:
                return None
        
        return value
    
    def _extract_file_urls(self, data: Dict[str, Any], track_id: str) -> List[Dict]:
        """提取文件URL"""
        file_urls = []
        
        # 根据API响应结构提取文件链接
        file_fields = {{ file_fields }}
        
        for file_type, api_field in file_fields.items():
            urls = self._get_nested_value(data, api_field)
            
            if urls:
                if isinstance(urls, str):
                    urls = [urls]
                
                for idx, url in enumerate(urls, 1):
                    file_urls.append({
                        'url': url,
                        'type': file_type,
                        'track_id': track_id,
                        'index': idx if len(urls) > 1 else None,
                    })
        
        return file_urls
    
    def handle_error(self, failure):
        """处理请求错误"""
        logger.error(f"API请求失败: {failure.request.url}")
        logger.error(f"错误信息: {failure.value}")
        self.stats['errors'] += 1
    
    def closed(self, reason):
        """Spider关闭时的回调"""
        logger.info("=" * 50)
        logger.info(f"Spider {{ spider_name }} 已关闭")
        logger.info(f"关闭原因: {reason}")
        logger.info(f"采集统计:")
        logger.info(f"  - 总项目数: {self.stats['total_items']}")
        logger.info(f"  - API调用次数: {self.stats['total_api_calls']}")
        logger.info(f"  - 错误数: {self.stats['errors']}")
        logger.info("=" * 50)
